style.fill: "#0d1117"
classes: {
  module-group: {
    style: {fill: transparent; stroke: "#8b949e"; stroke-dash: 5; border-radius: 30; font-color: "#c9d1d9"}
  }
  file-group: {
    style: {fill: transparent; stroke: "#6b7280"; stroke-width: 1; border-radius: 8; font-color: "#9ca3af"; font: mono; bold: false}
  }
  module: {
    style: {fill: "#0d1117"; stroke: "#c9d1d9"; font-color: "#c9d1d9"; stroke-width: 1; font: mono; bold: false}
  }
  file: {
    style: {fill: "#0d1117"; stroke: "#38bdf8"; font-color: "#38bdf8"; stroke-width: 1; font: mono; bold: false}
  }
  type: {
    style: {fill: "#0d1117"; stroke: "#38bdf8"; font-color: "#38bdf8"; stroke-width: 1; font: mono; bold: false}
  }
  interface: {
    style: {fill: "#0d1117"; stroke: "#c084fc"; font-color: "#c084fc"; stroke-width: 1; font: mono; bold: false}
  }
  function: {
    shape: oval
    style: {fill: "#0d1117"; stroke: "#fb923c"; font-color: "#fb923c"; stroke-width: 1; font: mono; bold: false}
  }
  enum: {
    style: {fill: "#0d1117"; stroke: "#22c55e"; font-color: "#22c55e"; stroke-width: 1; font: mono; bold: false}
  }
  neighbour: {
    style: {opacity: 0.45}
  }
  removed: {
    style: {stroke-dash: 3}
  }
  from-module: {
    style: {stroke: "#c9d1d9"; stroke-width: 1}
  }
  from-file: {
    style: {stroke: "#38bdf8"; stroke-width: 1}
  }
  from-type: {
    style: {stroke: "#38bdf8"; stroke-width: 1}
  }
  from-interface: {
    style: {stroke: "#c084fc"; stroke-width: 1}
  }
  from-function: {
    style: {stroke: "#fb923c"; stroke-width: 1}
  }
  from-enum: {
    style: {stroke: "#22c55e"; stroke-width: 1}
  }
  implements: {
    style: {stroke-dash: 6}
    target-arrowhead: {shape: triangle; style.filled: false}
  }
  inferred: {
    style: {stroke-dash: 2}
  }
}
